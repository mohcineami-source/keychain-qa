# Copy this file's variable NAMES into Netlify (Site settings → Environment variables).
# Never commit a real .env file — it's already git-ignored.

# The service account's email, e.g. nada-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, from the downloaded JSON key file's "private_key" field.
# Paste it as ONE line with literal \n where the real file has newlines — the function
# converts \n back to real newlines automatically. Example shape:
# -----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n
GOOGLE_PRIVATE_KEY=

# The spreadsheet's ID — the long id in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Optional: the tab/sheet name orders are written to. Created automatically if missing.
GOOGLE_SHEET_TAB=Orders
